# Prototipo 2 - ArquiSoft (PoleBet) : configuracion de entorno
# Copia este archivo a `.env` antes de levantar el sistema:
#   cp .env.example .env
# Completa las variables requeridas antes de iniciar el sistema.

# ---- Puertos expuestos en la maquina host ----
# En el prototipo 2 SOLO se publican dos puertos: el Gateway (80) y Admin (8003).
# Estan fijos en docker-compose.yml porque son contrato de la Vista C&C; todo lo
# demas es interno a las redes de Docker.

# ---- PostgreSQL Usuarios (dueño: servicio usuarios) ----
USUARIOS_DB_USER=arqui
USUARIOS_DB_PASSWORD=arqui_pass
USUARIOS_DB_NAME=usuarios_db

# ---- PostgreSQL Pagos (dueño: servicio pagos) ----
PAGOS_DB_USER=arqui
PAGOS_DB_PASSWORD=arqui_pass
PAGOS_DB_NAME=pagos_db

# ---- MongoDB (escribe el Ingestor; lee el Motor) ----
MONGO_USER=arqui
MONGO_PASSWORD=arqui_pass
MONGO_DB=apuestas_db

# ---- RabbitMQ (Broker: Admin <-> Pagos / Ingestor) ----
RABBITMQ_USER=arqui
RABBITMQ_PASSWORD=arqui_pass

# ---- Origenes del front permitidos (solo WebSocket detras de proxy) ----
# Con el Gateway como unica entrada, todo es del MISMO origen (http://localhost).
# En la LAN o la nube, agrega aqui el origen por el que se abra el front.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ---- Autenticacion / JWT (compartido entre servicios) ----
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion
JWT_EXPIRE_MINUTES=120
# Token de servicio para /internal/* (header X-Internal-Service-Token).
# Los servicios exigen al menos 32 caracteres; si falta, no arrancan.
# Solo para desarrollo local. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=cambiar-este-token-interno-solo-dev-32chars

# ---- Economia del token (RF-05) ----
# Cuantos COP vale 1 token. Tasa fija configurable para el prototipo.
COP_PER_TOKEN=1000

# ---- Usuario administrador ----
# Solo para desarrollo local. Cambiar en cualquier entorno compartido.
ADMIN_EMAIL=admin@arqui.local
ADMIN_PASSWORD=cambiar-esta-clave-solo-dev
ADMIN_NAME=Administrador

# ---- Ciclo del mercado (RF-10, RF-13, RNF-19) ----
BETTING_WINDOW_SECONDS=30
OBSERVATION_WINDOW_SECONDS=60
