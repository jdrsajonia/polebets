# Prototipo 2 - ArquiSoft (PoleBet) : configuracion de entorno
# Copia este archivo a `.env` antes de levantar el sistema:
#   cp .env.example .env
# Completa las variables requeridas antes de iniciar el sistema.

# ---- Puertos expuestos en la maquina host ----
# SOLO se publica el Gateway: 443 (HTTPS) y 80 (redirige a HTTPS). Admin ya no
# tiene puerto propio: se alcanza por el Gateway en https://localhost/api/admin
# (prototipo 3, escenario 2). Estan fijos en docker-compose.yml porque son
# contrato de la Vista C&C; todo lo demas es interno a las redes de Docker.
# Los certificados del Gateway se generan con scripts/generar-certs.sh (en
# Windows, desde Git Bash); los clientes confian en services/gateway/certs/ca.crt.

# ---- PostgreSQL Usuarios (dueño: servicio usuarios) ----
USUARIOS_DB_USER=arqui
USUARIOS_DB_PASSWORD=arqui_pass
USUARIOS_DB_NAME=usuarios_db

# ---- PostgreSQL Pagos (dueño: servicio pagos) ----
PAGOS_DB_USER=arqui
PAGOS_DB_PASSWORD=arqui_pass
PAGOS_DB_NAME=pagos_db

# ---- MongoDB (escribe el Ingestor; lee el Motor) ----
MONGO_USER=arqui
MONGO_PASSWORD=arqui_pass
MONGO_DB=apuestas_db

# ---- OpenF1 (lo usa solo el Ingestor) ----
# Opcional: el histórico es gratis sin token. Si se deja vacío no se manda Authorization.
OPENF1_API_KEY=

# ---- RabbitMQ (Broker: Admin <-> Pagos / Ingestor) ----
RABBITMQ_USER=arqui
RABBITMQ_PASSWORD=arqui_pass

# ---- Origenes del front permitidos (solo WebSocket detras de proxy) ----
# Con el Gateway como unica entrada, todo es del MISMO origen (https://localhost).
# En la LAN o la nube, agrega aqui el origen por el que se abra el front.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ---- Autenticacion / JWT de la cookie de sesion ----
# Solo lo recibe Usuarios (escenario 4): con HS256 quien verifica tambien puede
# firmar. Los demas servicios verifican la identidad firmada con la llave
# publica de scripts/generar-llaves-identidad.sh (no va en este archivo).
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion
JWT_EXPIRE_MINUTES=120
# Tokens de servicio para /internal/* (header X-Internal-Service-Token).
# Escenario 4: uno por cada par llamador -> destino; cada servicio acepta solo
# los de quienes deben llamarlo, asi que el de Pagos no sirve contra Usuarios
# ni contra el Motor. Minimo 32 caracteres y distintos entre si; si falta
# alguno, el servicio no arranca. Estos valores son solo para desarrollo
# local: para cambiarlos por aleatorios, scripts/generar-tokens-servicio.sh
TOKEN_ORQUESTADOR_USUARIOS=dev-token-orquestador-a-usuarios-cambiar
TOKEN_ORQUESTADOR_PAGOS=dev-token-orquestador-a-pagos-cambiar-xxx
TOKEN_ORQUESTADOR_MOTOR=dev-token-orquestador-a-motor-cambiar-xxx
TOKEN_MOTOR_PAGOS=dev-token-motor-a-pagos-cambiar-xxxxxxxxxx

# ---- Economia del token (RF-05) ----
# Cuantos COP vale 1 token. Tasa fija configurable para el prototipo.
COP_PER_TOKEN=1000

# ---- Usuario administrador ----
# Solo para desarrollo local. Cambiar en cualquier entorno compartido.
ADMIN_EMAIL=admin@arqui.local
ADMIN_PASSWORD=cambiar-esta-clave-solo-dev
ADMIN_NAME=Administrador

# ---- Ciclo del mercado (RF-10, RF-13, RNF-19) ----
BETTING_WINDOW_SECONDS=30
OBSERVATION_WINDOW_SECONDS=60
