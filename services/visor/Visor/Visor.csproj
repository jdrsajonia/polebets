<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Visor de pista (HU2-15): Blazor WebAssembly publicado como el elemento
       <visor-pista>. El Front copia _framework/ y _content/ a su raíz. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Visor</RootNamespace>
    <!-- Sin datos de culturas (ICU): el visor no formatea fechas ni monedas y pesa menos. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.CustomElements" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Visor.Nucleo\Visor.Nucleo.csproj" />
  </ItemGroup>

</Project>
